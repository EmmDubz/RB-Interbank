RB_BIND=127.0.0.1
RB_PORT=8787
# Hub signing material lives here, mode 0600, not in git.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RB_HUB_MASTER=
# JSON list of member banks. Secrets stay in this 0600 file, never in git.
# RB_PEERS=[{"bank":"DRB","url":"https://drb-host/rb/v1","secret":"..."},{"bank":"VDRB","url":"https://vdrb-host/rb/v1","secret":"..."}]
RB_PEERS=
